{%- set bore_str = p.taxonomy_5.split('_')[0] -%}
{%- set bore_mm = bore_str | int -%}
{%- set od_mm = p.od | int -%}
{%- set depth_mm = p.depth | int -%}
{%- set sc = 100 -%}
{%- set cx_f = 5500 -%}
{%- set cx_s = 15500 -%}
{%- set cy_d = 14200 -%}
{%- set od_r = (od_mm * sc) // 2 -%}
{%- set bore_r = (bore_mm * sc) // 2 -%}
{%- set depth_hw = (depth_mm * sc) // 2 -%}
{%- set dim_gap = 800 -%}
{%- set dim_y_top = cy_d - od_r - dim_gap -%}
{%- set dim_y_bot = cy_d + od_r + dim_gap -%}
{%- set dim_x_r = cx_s + depth_hw + 1100 -%}
{%- set sw_border = 210 -%}
{%- set sw_main = 72 -%}
{%- set sw_section = 48 -%}
{%- set sw_dim = 30 -%}
{%- set tick = 170 -%}
<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg xmlns="http://www.w3.org/2000/svg"
     width="210mm" height="297mm" viewBox="0 0 21000 29700" version="1.1"
     style="shape-rendering:geometricPrecision;text-rendering:geometricPrecision">

  <!-- Quiet A4 engineering sheet: ASCII-only labels avoid encoding problems. -->
  <rect width="21000" height="29700" fill="#ffffff"/>
  <rect x="400" y="400" width="20200" height="28900" rx="700" ry="700"
        fill="none" stroke="#000000" stroke-width="{{ sw_border }}"/>

  <!-- Header -->
  <text x="1000" y="1550" fill="#000000" fill-opacity="0.55" font-family="Arial, Helvetica, sans-serif"
        font-size="340" font-weight="bold" letter-spacing="90">OOMLOUT / BEARING</text>
  <text x="1000" y="2840" fill="#000000" font-family="Arial, Helvetica, sans-serif"
        font-size="1600" font-weight="bold">{{ p.size }}</text>
  <text x="1000" y="3420" fill="#000000" fill-opacity="0.60" font-family="Arial, Helvetica, sans-serif"
        font-size="470">{{ p.series }} SERIES</text>
  <line x1="1000" y1="3850" x2="20000" y2="3850" stroke="#000000" stroke-width="{{ sw_section }}"/>

  <!-- Drawing heading -->
  <text x="1000" y="4580" fill="#000000" font-family="Arial, Helvetica, sans-serif"
        font-size="520" font-weight="bold">DIMENSIONS</text>
  <text x="20000" y="4580" fill="#000000" fill-opacity="0.55" font-family="Arial, Helvetica, sans-serif"
        font-size="340" text-anchor="end">1:1 RATIO - PRINT AT 100%</text>

  <!-- View labels -->
  <text x="{{ cx_f }}" y="5350" fill="#000000" fill-opacity="0.65" font-family="Arial, Helvetica, sans-serif"
        font-size="340" font-weight="bold" text-anchor="middle" letter-spacing="55">FRONT</text>
  <text x="{{ cx_s }}" y="5350" fill="#000000" fill-opacity="0.65" font-family="Arial, Helvetica, sans-serif"
        font-size="340" font-weight="bold" text-anchor="middle" letter-spacing="55">SIDE</text>

  <!-- Front view -->
  <circle cx="{{ cx_f }}" cy="{{ cy_d }}" r="{{ od_r }}" fill="#f4f4f2" stroke="#000000" stroke-width="{{ sw_main }}"/>
  <circle cx="{{ cx_f }}" cy="{{ cy_d }}" r="{{ bore_r }}" fill="#ffffff" stroke="#000000" stroke-width="{{ sw_main }}"/>

  <!-- Side view -->
  <rect x="{{ cx_s - depth_hw }}" y="{{ cy_d - od_r }}" width="{{ depth_hw * 2 }}" height="{{ od_r * 2 }}"
        fill="#f4f4f2" stroke="#000000" stroke-width="{{ sw_main }}"/>
  <rect x="{{ cx_s - depth_hw }}" y="{{ cy_d - bore_r }}" width="{{ depth_hw * 2 }}" height="{{ bore_r * 2 }}"
        fill="#ffffff" stroke="#000000" stroke-width="{{ sw_main }}"/>

  <!-- OD across front -->
  <g fill="none" stroke="#000000" stroke-width="{{ sw_dim }}">
    <line x1="{{ cx_f - od_r }}" y1="{{ cy_d - od_r }}" x2="{{ cx_f - od_r }}" y2="{{ dim_y_top + tick }}"/>
    <line x1="{{ cx_f + od_r }}" y1="{{ cy_d - od_r }}" x2="{{ cx_f + od_r }}" y2="{{ dim_y_top + tick }}"/>
    <line x1="{{ cx_f - od_r }}" y1="{{ dim_y_top }}" x2="{{ cx_f + od_r }}" y2="{{ dim_y_top }}"/>
    <line x1="{{ cx_f - od_r }}" y1="{{ dim_y_top - tick }}" x2="{{ cx_f - od_r }}" y2="{{ dim_y_top + tick }}"/>
    <line x1="{{ cx_f + od_r }}" y1="{{ dim_y_top - tick }}" x2="{{ cx_f + od_r }}" y2="{{ dim_y_top + tick }}"/>
  </g>
  <text x="{{ cx_f }}" y="{{ dim_y_top - 230 }}" fill="#000000" font-family="Arial, Helvetica, sans-serif"
        font-size="430" font-weight="bold" text-anchor="middle">OD {{ p.od }} mm</text>

  <!-- Bore across front -->
  <g fill="none" stroke="#000000" stroke-width="{{ sw_dim }}">
    <line x1="{{ cx_f - bore_r }}" y1="{{ cy_d + bore_r }}" x2="{{ cx_f - bore_r }}" y2="{{ dim_y_bot - tick }}"/>
    <line x1="{{ cx_f + bore_r }}" y1="{{ cy_d + bore_r }}" x2="{{ cx_f + bore_r }}" y2="{{ dim_y_bot - tick }}"/>
    <line x1="{{ cx_f - bore_r }}" y1="{{ dim_y_bot }}" x2="{{ cx_f + bore_r }}" y2="{{ dim_y_bot }}"/>
    <line x1="{{ cx_f - bore_r }}" y1="{{ dim_y_bot - tick }}" x2="{{ cx_f - bore_r }}" y2="{{ dim_y_bot + tick }}"/>
    <line x1="{{ cx_f + bore_r }}" y1="{{ dim_y_bot - tick }}" x2="{{ cx_f + bore_r }}" y2="{{ dim_y_bot + tick }}"/>
  </g>
  <text x="{{ cx_f }}" y="{{ dim_y_bot + 500 }}" fill="#000000" font-family="Arial, Helvetica, sans-serif"
        font-size="430" font-weight="bold" text-anchor="middle">ID {{ bore_str }} mm</text>

  <!-- Width across side -->
  <g fill="none" stroke="#000000" stroke-width="{{ sw_dim }}">
    <line x1="{{ cx_s - depth_hw }}" y1="{{ cy_d - od_r }}" x2="{{ cx_s - depth_hw }}" y2="{{ dim_y_top + tick }}"/>
    <line x1="{{ cx_s + depth_hw }}" y1="{{ cy_d - od_r }}" x2="{{ cx_s + depth_hw }}" y2="{{ dim_y_top + tick }}"/>
    <line x1="{{ cx_s - depth_hw }}" y1="{{ dim_y_top }}" x2="{{ cx_s + depth_hw }}" y2="{{ dim_y_top }}"/>
    <line x1="{{ cx_s - depth_hw }}" y1="{{ dim_y_top - tick }}" x2="{{ cx_s - depth_hw }}" y2="{{ dim_y_top + tick }}"/>
    <line x1="{{ cx_s + depth_hw }}" y1="{{ dim_y_top - tick }}" x2="{{ cx_s + depth_hw }}" y2="{{ dim_y_top + tick }}"/>
  </g>
  <text x="{{ cx_s }}" y="{{ dim_y_top - 230 }}" fill="#000000" font-family="Arial, Helvetica, sans-serif"
        font-size="430" font-weight="bold" text-anchor="middle">WIDTH {{ p.depth }} mm</text>

  <!-- OD beside side view -->
  <g fill="none" stroke="#000000" stroke-width="{{ sw_dim }}">
    <line x1="{{ cx_s + depth_hw }}" y1="{{ cy_d - od_r }}" x2="{{ dim_x_r - tick }}" y2="{{ cy_d - od_r }}"/>
    <line x1="{{ cx_s + depth_hw }}" y1="{{ cy_d + od_r }}" x2="{{ dim_x_r - tick }}" y2="{{ cy_d + od_r }}"/>
    <line x1="{{ dim_x_r }}" y1="{{ cy_d - od_r }}" x2="{{ dim_x_r }}" y2="{{ cy_d + od_r }}"/>
    <line x1="{{ dim_x_r - tick }}" y1="{{ cy_d - od_r }}" x2="{{ dim_x_r + tick }}" y2="{{ cy_d - od_r }}"/>
    <line x1="{{ dim_x_r - tick }}" y1="{{ cy_d + od_r }}" x2="{{ dim_x_r + tick }}" y2="{{ cy_d + od_r }}"/>
  </g>
  <text x="{{ dim_x_r + 310 }}" y="{{ cy_d }}" fill="#000000" font-family="Arial, Helvetica, sans-serif"
        font-size="400" font-weight="bold" text-anchor="middle" transform="rotate(-90, {{ dim_x_r + 310 }}, {{ cy_d }})">OD {{ p.od }} mm</text>

  <!-- Summary: one concise line, no duplicated taxonomy data. -->
  <line x1="1000" y1="23250" x2="20000" y2="23250" stroke="#000000" stroke-width="{{ sw_section }}"/>
  <text x="1000" y="24300" fill="#000000" font-family="Arial, Helvetica, sans-serif"
        font-size="700" font-weight="bold">{{ bore_str }} mm ID</text>
  <text x="6500" y="24300" fill="#000000" font-family="Arial, Helvetica, sans-serif"
        font-size="700" font-weight="bold">{{ p.od }} mm OD</text>
  <text x="12000" y="24300" fill="#000000" font-family="Arial, Helvetica, sans-serif"
        font-size="700" font-weight="bold">{{ p.depth }} mm WIDTH</text>

  <line x1="1000" y1="25000" x2="20000" y2="25000" stroke="#000000" stroke-opacity="0.25" stroke-width="{{ sw_dim }}"/>
  <text x="1000" y="25800" fill="#000000" fill-opacity="0.55" font-family="Arial, Helvetica, sans-serif" font-size="300">PART</text>
  <text x="1000" y="26310" fill="#000000" fill-opacity="0.80" font-family="Arial, Helvetica, sans-serif" font-size="370">{{ p.id }}</text>

  <line x1="1000" y1="27650" x2="20000" y2="27650" stroke="#000000" stroke-opacity="0.25" stroke-width="{{ sw_dim }}"/>
  <text x="1000" y="28350" fill="#000000" fill-opacity="0.55" font-family="Arial, Helvetica, sans-serif" font-size="300">OOMLOUT</text>
  <text x="20000" y="28350" fill="#000000" fill-opacity="0.65" font-family="Arial, Helvetica, sans-serif" font-size="300" text-anchor="end">{{ p.md5_6_alpha_upper }}</text>
</svg>
